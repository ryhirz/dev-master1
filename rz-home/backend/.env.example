# Rz家居 后端环境变量（复制为 .env 后修改；config 通过环境变量读取）
# 本地开发：
ENV=dev
DEBUG=true

# 数据库：Dev SQLite / Prod PostgreSQL
# 本地开发（默认）：sqlite:///./rz_home.db
# 生产示例：postgresql+psycopg2://rz:strongpwd@localhost:5432/rz_home?sslmode=require
DATABASE_URL=sqlite:///./rz_home.db

# 安全（生产务必替换为强随机值，可用：python -c "import secrets;print(secrets.token_urlsafe(48))"）
SECRET_KEY=vF0315zXE8Rt0Bgfkt5dbsZ1EQtH6WrRfG8tFEBacNDtKj0XU2pnqUm63Bmbm50T
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（本地联调前端源；生产填真实域名）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 上传（生产建议指向持久卷，如 /app/static/uploads）
UPLOAD_DIR=
# 上传 / 限频
MAX_UPLOAD_MB=10
MESSAGE_RATE_LIMIT_PER_MIN=10
